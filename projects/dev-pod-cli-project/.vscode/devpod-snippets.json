{
    "DevPod: Create Workspace": {
        "prefix": "devpod-up",
        "body": [
            "devpod up --id ${1:workspace-name} ${2:.}"
        ],
        "description": "Create a new DevPod workspace"
    },
    "DevPod: List Workspaces": {
        "prefix": "devpod-list",
        "body": [
            "devpod list"
        ],
        "description": "List all DevPod workspaces"
    },
    "DevPod: Check Status": {
        "prefix": "devpod-status",
        "body": [
            "devpod status ${1:workspace-name}"
        ],
        "description": "Check workspace status"
    },
    "DevPod: SSH Access": {
        "prefix": "devpod-ssh",
        "body": [
            "devpod ssh ${1:workspace-name}"
        ],
        "description": "SSH into workspace"
    },
    "DevPod: Execute Command": {
        "prefix": "devpod-exec",
        "body": [
            "devpod ssh ${1:workspace-name} -- \"${2:command}\""
        ],
        "description": "Execute command in workspace"
    },
    "DevPod: Open IDE": {
        "prefix": "devpod-ide",
        "body": [
            "devpod ide ${1|vscode,openvscode|} ${2:workspace-name}"
        ],
        "description": "Open workspace in IDE"
    },
    "DevPod: Stop Workspace": {
        "prefix": "devpod-stop",
        "body": [
            "devpod stop ${1:workspace-name}"
        ],
        "description": "Stop a workspace"
    },
    "DevPod: Delete Workspace": {
        "prefix": "devpod-delete",
        "body": [
            "devpod delete ${1:workspace-name}"
        ],
        "description": "Delete a workspace"
    },
    "DevPod: View Logs": {
        "prefix": "devpod-logs",
        "body": [
            "devpod logs ${1:workspace-name}"
        ],
        "description": "View workspace logs"
    },
    "DevPod: List Providers": {
        "prefix": "devpod-providers",
        "body": [
            "devpod provider list"
        ],
        "description": "List available providers"
    },
    "DevPod: Version": {
        "prefix": "devpod-version",
        "body": [
            "devpod version"
        ],
        "description": "Show DevPod version"
    },
    "DevPod: Create from Git": {
        "prefix": "devpod-git",
        "body": [
            "devpod up --id ${1:workspace-name} ${2:https://github.com/user/repo}"
        ],
        "description": "Create workspace from Git repository"
    },
    "DevPod: Full Setup": {
        "prefix": "devpod-setup",
        "body": [
            "# Create and configure DevPod workspace",
            "devpod up --id ${1:my-workspace} ${2:.}",
            "devpod ide vscode ${1:my-workspace}",
            "devpod ssh ${1:my-workspace} -- \"${3:setup-command}\""
        ],
        "description": "Complete DevPod workspace setup"
    }
}