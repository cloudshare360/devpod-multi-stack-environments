{
    "name": "NodeJS Project Workspace",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:18",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "18",
            "nodeGypDependencies": true
        },
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                // AI-Powered Development
                "github.copilot",
                "github.copilot-chat",
                
                // Core Node.js Development
                "ms-vscode.vscode-typescript-next",
                "ms-vscode.vscode-json",
                "ms-vscode.vscode-eslint",
                "esbenp.prettier-vscode",
                
                // Code Execution & Testing
                "formulahendry.code-runner",
                "augustocdias.tasks-shell-input",
                "ms-vscode.test-adapter-converter",
                "orta.vscode-jest",
                "hbenl.vscode-test-explorer",
                
                // Node.js Specific
                "ms-vscode.vscode-npm-script",
                "christian-kohler.npm-intellisense",
                "eg2.vscode-npm-script",
                "leizongmin.node-module-intellisense",
                
                // API Development & HTTP
                "humao.rest-client",
                "rangav.vscode-thunder-client",
                "ms-vscode.vscode-json5",
                "redhat.vscode-yaml",
                
                // Git & Version Control
                "eamodio.gitlens",
                "github.vscode-github-actions",
                "ms-vscode.vscode-pull-request-github",
                "github.vscode-pull-request-github",
                
                // DevContainer & Docker
                "ms-vscode-remote.remote-containers",
                "ms-azuretools.vscode-docker",
                
                // Web Development
                "ms-vscode.live-server",
                "ritwickdey.liveserver",
                "formulahendry.auto-rename-tag",
                "bradlc.vscode-tailwindcss",
                "pranaygp.vscode-css-peek",
                
                // Productivity & Navigation
                "christian-kohler.path-intellisense",
                "streetsidesoftware.code-spell-checker",
                "ms-vscode.vscode-todo-highlight",
                "gruntfuggly.todo-tree",
                "ms-vscode.wordcount",
                "alefragnani.bookmarks",
                
                // Terminal & Shell
                "timonwong.shellcheck",
                "rogalmic.bash-debug",
                "mads-hartmann.bash-ide-vscode",
                
                // Documentation & Markdown
                "yzhang.markdown-all-in-one",
                "shd101wyy.markdown-preview-enhanced",
                "davidanson.vscode-markdownlint",
                
                // Database Support
                "ms-ossdata.vscode-postgresql",
                "cweijan.vscode-postgresql-client2",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg",
                "cweijan.vscode-mysql-client2",
                "bradlc.vscode-mongodb",
                
                // Theme & UI Enhancement
                "pkief.material-icon-theme",
                "zhuangtongfa.material-theme",
                "ms-vscode.theme-predawn",
                
                // Code Quality & Formatting
                "dbaeumer.vscode-eslint",
                "bradlc.vscode-tailwindcss",
                "ms-vscode.vscode-typescript-next"
            ],
            "settings": {
                // Editor Configuration
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.fixAll.eslint": "explicit"
                },
                "editor.tabSize": 2,
                "editor.insertSpaces": true,
                "editor.detectIndentation": false,
                
                // TypeScript/JavaScript
                "typescript.updateImportsOnFileMove.enabled": "always",
                "typescript.preferences.quoteStyle": "single",
                "javascript.preferences.quoteStyle": "single",
                "typescript.suggest.autoImports": true,
                "javascript.suggest.autoImports": true,
                
                // Files
                "files.autoSave": "afterDelay",
                "files.autoSaveDelay": 1000,
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,
                
                // Terminal
                "terminal.integrated.shell.linux": "/bin/bash",
                "terminal.integrated.defaultProfile.linux": "bash",
                
                // Testing
                "jest.autoRun": "watch",
                "jest.showCoverageOnLoad": true,
                
                // Git
                "git.enableSmartCommit": true,
                "git.confirmSync": false,
                "gitlens.views.repositories.location": "scm",
                
                // Workbench
                "workbench.startupEditor": "readme",
                "window.menuBarVisibility": "classic",
                "window.enableMenuBarMnemonics": true
            }
        }
    },
    "forwardPorts": [9000, 3001, 5434, 8082],
    "portsAttributes": {
        "9000": {
            "label": "Node.js API Server",
            "onAutoForward": "notify"
        },
        "5434": {
            "label": "PostgreSQL Database",
            "onAutoForward": "silent"
        },
        "8082": {
            "label": "pgAdmin UI",
            "onAutoForward": "notify"
        }
    },
    "postCreateCommand": "npm install && npm run setup",
    "postStartCommand": "echo 'DevPod workspace ready! Run: npm run dev'",
    "remoteUser": "node",
    "workspaceFolder": "/workspaces/nodejs-project-workspace",
    "shutdownAction": "stopContainer"
}