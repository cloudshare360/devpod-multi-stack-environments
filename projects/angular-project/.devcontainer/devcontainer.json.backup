{
    "name": "Angular Development Environment",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:18",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {"version": "18"}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                // Core Angular Development
                "Angular.ng-template",
                "ms-vscode.vscode-typescript-next",
                "johnpapa.Angular2",
                "cyrilletuzi.angular-schematics",
                "nrwl.angular-console",
                
                // Code Execution & Testing
                "formulahendry.code-runner",
                "augustocdias.tasks-shell-input",
                "orta.vscode-jest",
                "hbenl.vscode-test-explorer",
                "ms-vscode.test-adapter-converter",
                "raagh.angular-karma-test-explorer",
                
                // Angular Specific Tools
                "angular.ng-template",
                "johnpapa.angular2",
                "mikerhyssmith.angular-json-editor",
                "cyrilletuzi.angular-schematics",
                "ms-vscode.vscode-angular-cli",
                
                // CSS & Styling
                "bradlc.vscode-tailwindcss",
                "zignd.html-css-class-completion",
                "pranaygp.vscode-css-peek",
                "stylelint.vscode-stylelint",
                "ms-vscode.vscode-css-formatter",
                
                // Code Quality & Formatting
                "ms-vscode.vscode-eslint",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "ms-vscode.vscode-tslint",
                
                // Web Development
                "ms-vscode.live-server",
                "ritwickdey.liveserver",
                "formulahendry.auto-rename-tag",
                "christian-kohler.npm-intellisense",
                "ms-vscode.vscode-npm-script",
                
                // API Development
                "humao.rest-client",
                "rangav.vscode-thunder-client",
                "ms-vscode.vscode-json5",
                "redhat.vscode-yaml",
                
                // File Support & Syntax
                "ms-vscode.vscode-json",
                "redhat.vscode-xml",
                "ms-vscode.vscode-html",
                "redhat.vscode-yaml",
                
                // Git & Version Control
                "eamodio.gitlens",
                "github.vscode-github-actions",
                "ms-vscode.vscode-pull-request-github",
                
                // DevContainer & Docker
                "ms-vscode-remote.remote-containers",
                "ms-azuretools.vscode-docker",
                
                // Productivity & Navigation
                "christian-kohler.path-intellisense",
                "streetsidesoftware.code-spell-checker",
                "ms-vscode.vscode-todo-highlight",
                "gruntfuggly.todo-tree",
                "ms-vscode.wordcount",
                "alefragnani.bookmarks",
                
                // Terminal & Shell
                "timonwong.shellcheck",
                "rogalmic.bash-debug",
                "mads-hartmann.bash-ide-vscode",
                
                // Documentation & Markdown
                "yzhang.markdown-all-in-one",
                "shd101wyy.markdown-preview-enhanced",
                "davidanson.vscode-markdownlint",
                
                // Component Development
                "steoates.autoimport-es6-ts",
                "wix.vscode-import-cost",
                "ms-vscode.vscode-typescript-next",
                
                // Theme & UI Enhancement
                "pkief.material-icon-theme",
                "zhuangtongfa.material-theme",
                "ms-vscode.theme-predawn"
            ]
        }
    },
    "forwardPorts": [4200, 4201, 5437, 8085],
    "postCreateCommand": "npm install -g @angular/cli@17 && npm install",
    "remoteUser": "node"
}
