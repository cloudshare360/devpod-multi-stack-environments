{
    "name": "Angular-Java-PostgreSQL Stack",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "development",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                // Core Fullstack Development
                "Angular.ng-template",
                "redhat.java",
                "ms-vscode.vscode-typescript-next",
                "vscjava.vscode-java-pack",
                
                // Code Execution & Testing
                "formulahendry.code-runner",
                "augustocdias.tasks-shell-input",
                "orta.vscode-jest",
                "hbenl.vscode-test-explorer",
                "ms-vscode.test-adapter-converter",
                "vscjava.vscode-java-test",
                
                // Java Backend Development
                "vscjava.vscode-spring-boot-dashboard",
                "pivotal.vscode-spring-boot",
                "vscjava.vscode-spring-initializr",
                "vscjava.vscode-maven",
                "gabrielbb.vscode-lombok",
                
                // Angular Frontend Development
                "johnpapa.Angular2",
                "cyrilletuzi.angular-schematics",
                "nrwl.angular-console",
                "mikerhyssmith.angular-json-editor",
                
                // Database & API
                "ms-ossdata.vscode-postgresql",
                "humao.rest-client",
                "rangav.vscode-thunder-client",
                "cweijan.vscode-mysql-client2",
                "ms-mssql.mssql",
                
                // CSS & Styling
                "bradlc.vscode-tailwindcss",
                "zignd.html-css-class-completion",
                "pranaygp.vscode-css-peek",
                "stylelint.vscode-stylelint",
                
                // Code Quality & Formatting
                "ms-vscode.vscode-eslint",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "ms-vscode.vscode-tslint",
                
                // Web Development
                "ms-vscode.live-server",
                "ritwickdey.liveserver",
                "formulahendry.auto-rename-tag",
                "christian-kohler.npm-intellisense",
                "ms-vscode.vscode-npm-script",
                
                // File Support & Syntax
                "ms-vscode.vscode-json",
                "redhat.vscode-xml",
                "redhat.vscode-yaml",
                "ms-vscode.vscode-json5",
                "ms-vscode.vscode-html",
                
                // Git & Version Control
                "eamodio.gitlens",
                "github.vscode-github-actions",
                "ms-vscode.vscode-pull-request-github",
                
                // DevContainer & Docker
                "ms-vscode-remote.remote-containers",
                "ms-azuretools.vscode-docker",
                
                // Productivity & Navigation
                "christian-kohler.path-intellisense",
                "streetsidesoftware.code-spell-checker",
                "ms-vscode.vscode-todo-highlight",
                "gruntfuggly.todo-tree",
                "ms-vscode.wordcount",
                "alefragnani.bookmarks",
                
                // Terminal & Shell
                "timonwong.shellcheck",
                "rogalmic.bash-debug",
                "mads-hartmann.bash-ide-vscode",
                
                // Documentation & Markdown
                "yzhang.markdown-all-in-one",
                "shd101wyy.markdown-preview-enhanced",
                "davidanson.vscode-markdownlint",
                
                // Fullstack Tools
                "steoates.autoimport-es6-ts",
                "wix.vscode-import-cost",
                "ms-vscode.vscode-typescript-next",
                
                // Theme & UI Enhancement
                "pkief.material-icon-theme",
                "zhuangtongfa.material-theme",
                "ms-vscode.theme-predawn"
            ]
        }
    },
    "forwardPorts": [4210, 8095, 5439, 8087],
    "postCreateCommand": "cd frontend && npm install -g @angular/cli@17 && npm install"
}
